extends Node3D
## LanternWorld
##
## المشهد الذي يعرض عالم الفانوس الحي ويتيح التفاعل الفعلي الأول معه:
## نحت التضاريس باللمس (المرحلة 4). يحمّل أي تضاريس محفوظة من جلسة سابقة
## عند الدخول، ويحفظ تلقائيًا بعد كل لفتة نحت مكتملة عبر
## EventBus.world_state_changed — بلا أي زر "حفظ" يدوي يطلبه اللاعب.

const MAIN_MENU_SCENE := "res://scenes/main_menu/main_menu.tscn"

@onready var island: ProceduralIsland = $Island


func _ready() -> void:
	GameManager.current_state = GameManager.State.PLAYING
	EventBus.back_button_requested.connect(_on_back_requested)
	EventBus.world_state_changed.connect(_on_world_state_changed)
	_load_world_state()


func _on_back_requested() -> void:
	SceneManager.change_scene(MAIN_MENU_SCENE)


func _on_world_state_changed() -> void:
	SaveManager.save_game(SaveManager.build_current_save_data())


func _load_world_state() -> void:
	var save_data := SaveManager.load_game()
	if save_data.has("world"):
		load_save_data(save_data["world"])


## يُستدعى من SaveManager (عبر فحص get_save_data ديناميكيًا — راجع
## docs/ARCHITECTURE.md) ليجمع كل ما يحتاج هذا المشهد حفظه. لاحقًا سيضم
## أيضًا بيانات المخلوقات والنباتات حين تُبنى.
func get_save_data() -> Dictionary:
	var heights := island.get_height_data()
	# تقريب لثلاث خانات عشرية يقلّص حجم ملف الحفظ كثيرًا (JSON يكتب
	# float32 بكامل دقته الظاهرية وإلا) دون أي أثر مرئي — 0.001 وحدة أصغر
	# بكثير من أن تُلاحَظ في تضاريس بهذا الحجم.
	var rounded := PackedFloat32Array()
	rounded.resize(heights.size())
	for i in range(heights.size()):
		rounded[i] = snappedf(heights[i], 0.001)
	return {
		"island_heights": rounded,
	}


func load_save_data(data: Dictionary) -> void:
	if data.has("island_heights"):
		var raw: Array = data["island_heights"]
		island.set_height_data(PackedFloat32Array(raw))
